# LexMind AI — root env for docker-compose (LOCAL DEV ONLY).
# Copy to .env. Never commit a real .env. Production uses a secrets manager.
#
# Also copy backend/.env.example -> backend/.env and
# frontend/.env.example -> frontend/.env before `docker compose up`.

# PostgreSQL
POSTGRES_USER=lexmind
POSTGRES_PASSWORD=lexmind
POSTGRES_DB=lexmind

# MinIO (S3-compatible object storage) — local dev credentials
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Password for the restricted runtime DB role (lexmind_app) used for RLS.
# The migrate service creates the role with this password; the api connects as it.
APP_DB_PASSWORD=lexmind_app
