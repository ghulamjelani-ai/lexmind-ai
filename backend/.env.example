# LexMind AI backend — environment variables.
# Copy to .env for local dev. NEVER commit a real .env or real secrets.

# App
ENVIRONMENT=local
DEBUG=true
APP_NAME=LexMind AI

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Security
# Set true behind HTTPS (production); false for local http dev.
SECURE_COOKIES=false
# Field encryption key (Fernet, url-safe base64). REQUIRED in production.
# Generate: uv run python -c "from app.core.crypto import generate_key; print(generate_key())"
ENCRYPTION_KEY=

# PostgreSQL (pgvector)
# DATABASE_URL is the privileged connection (migrations + pre-tenant auth bootstrap).
DATABASE_URL=postgresql+psycopg://lexmind:lexmind@db:5432/lexmind
# APP_DATABASE_URL is the restricted, RLS-enforced runtime connection. Leave empty
# to fall back to DATABASE_URL (e.g. before the lexmind_app role exists).
APP_DATABASE_URL=
# Password for the restricted role, used by the RLS migration to create it.
APP_DB_PASSWORD=lexmind_app

# Redis (Celery broker/result backend + cache + rate limiting)
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO in local dev)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=lexmind-documents
# S3_ACCESS_KEY and S3_SECRET_KEY are injected from the environment / secrets
# manager — do not hardcode them here.
